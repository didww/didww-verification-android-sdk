<?xml version="1.0" encoding="utf-8"?>
<!--
  Plain HTTP has been blocked by default since API 28, and a locally-run backend is served
  over plain HTTP. This opts in for exactly two hosts.

  It is deliberately NOT `<base-config cleartextTrafficPermitted="true">`, which would
  disable TLS enforcement for every host the app talks to — including the real sandbox and
  production APIs, silently, for the life of the build.

  10.0.2.2 is the emulator's alias for the host machine's loopback, and is what the default
  configuration points at. Inside an emulator `localhost` is the emulator itself.

  `localhost` and 127.0.0.1 are here for the real-device path, where there is no 10.0.2.2:
  a handset reaches a server on the development machine through
  `adb reverse tcp:3000 tcp:3000`, which routes the device's own loopback back down the USB
  cable. The URL on the device then becomes http://localhost:3000. Listing both hosts is
  what lets one build serve an emulator and a handset with no rebuild.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
